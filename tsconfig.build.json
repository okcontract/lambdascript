{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules/**/*",
    "src/*.test.ts",
    "src/parser/*.test.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "typeRoots": [
      "node_modules/@types"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  }
}
