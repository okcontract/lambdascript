{
  "name": "@okcontract/lambdascript",
  "description": "lambdascript is a reactive functional scripting language",
  "private": false,
  "version": "0.1.0",
  "main": "dist/lambdascript.umd.cjs",
  "module": "dist/lambdascript.js",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lambdascript.js",
      "require": "./dist/lambdascript.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@lezer/generator": "^1.6.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@lezer/lr": "^1.4.2",
    "@okcontract/cells": "^0.4.0",
    "@okcontract/graph": "^0.2.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "grammar": "lezer-generator src/parser/λs.grammar -o src/parser/λs.js",
    "build": "bun run format && bun build src/index.ts --outfile dist/lambdascript.js --target browser --format esm --conditions=source --minify && bun build src/index.ts --outfile dist/lambdascript.umd.cjs --target browser --format cjs --conditions=source --minify",
    "test": "bun test --parallel",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "definitions": "tsc --project tsconfig.build.json",
    "prepublishOnly": "bun run grammar && bun run test && bun run build && bun run check && bun run definitions",
    "check": "biome check src",
    "format": "biome check src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okcontract/lambdascript.git"
  },
  "author": "Henri Binsztok",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/okcontract/lambdascript/issues"
  },
  "homepage": "https://hbbio.github.io/lambdascript"
}
